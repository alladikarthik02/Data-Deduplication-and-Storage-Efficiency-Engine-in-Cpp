# Build trees. check.sh configures one per sanitizer configuration; they are
# regenerated by:  ./scripts/dev.sh ./scripts/check.sh
build/
build-*/

# CMake scratch, in case anyone configures in-tree.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json

# Compiled output and debug symbol bundles.
*.o
*.a
*.so
*.dylib
*.dSYM/

# Generated benchmark data. bench_corpus writes its synthetic backup corpus to
# /tmp/dedupe-bench-corpus by default; it only lands here if pointed at the repo.
# Regenerate with:  ./scripts/dev.sh ./build-none/bench_corpus bench/data
bench/data/

# Spike scratch output. Regenerate with:  ./scripts/dev.sh ./scripts/check.sh
scratch/out/

# Local stores created while trying the CLI by hand.
*.store/

# Internal working notes, kept out of the repo on purpose.
CONTEXT1.md

# Editor and OS droppings.
.DS_Store
.vscode/
.idea/
*.swp
